{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["chrome"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@blocksite/core": ["./packages/core/src/index.ts"],
      "@blocksite/storage": ["./packages/storage/src/index.ts"],
      "@blocksite/event-bus": ["./packages/event-bus/src/index.ts"],
      "@blocksite/rules": ["./packages/rules/src/index.ts"],
      "@blocksite/schedule": ["./packages/schedule/src/index.ts"],
      "@blocksite/auth": ["./packages/auth/src/index.ts"],
      "@blocksite/unlock": ["./packages/unlock/src/index.ts"],
      "@blocksite/stats": ["./packages/stats/src/index.ts"],
      "@blocksite/presets": ["./packages/presets/src/index.ts"],
      "@blocksite/import-export": ["./packages/import-export/src/index.ts"],
      "@blocksite/categories": ["./packages/categories/src/index.ts"],
    },
  },
  "exclude": ["node_modules", "dist", ".output"],
}
